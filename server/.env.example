# Copy this file to .env and fill in your real values.
# .env is already in .gitignore — never commit your real secrets.

# --- PostgreSQL (local) ---
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tecsc

# --- Gmail (for sending the password-reset code) ---
GMAIL_USER=your_sending_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# --- The one lifetime admin account (used only when running seed-admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_EMAIL=fathers_real_email@gmail.com

# --- Server ---
PORT=4000

# --- Twilio (optional — for SMS/WhatsApp alerts). Leave blank to disable. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
ADMIN_ALERT_PHONE=